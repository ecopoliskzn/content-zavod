# Ключи: ни один файл окружения в git не попадает
.env
.env.*
!.env.example

# Данные завода, дубль расписания, витрина: живут вне кода
data/
mirror/
vault/

# Образцы кода из прошлых проектов исполнителя: клиенту и на сервер не уезжают
reference/

# Обёртки задач Windows создаёт установщик под конкретную машину
ops/windows/*.cmd

node_modules/
*.log
