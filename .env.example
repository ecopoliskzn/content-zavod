# Образец файла окружения завода. Собран из src/tokens/registry.mjs:
#   npm run tokens -- --example > .env.example
# Значений здесь нет и быть не должно. Настоящие файлы в git не попадают:
#   сервер                /opt/ecopolis-data/.env   (права 600, владелец zavod)
#   компьютер оператора   .env.local в корне проекта
#   релей                 /etc/zavod-relay.env на втором сервере либо секреты Cloudflare
# После пояснения в квадратных скобках: на каких машинах переменная нужна.
# Случайные секреты (ADMIN_API_TOKEN, TG_RELAY_SECRET, TG_WEBHOOK_SECRET, IG_RELAY_SECRET, IG_FORWARD_SECRET, IG_WEBHOOK_VERIFY_TOKEN) создаёт
# команда на сервере: node src/tokens/check.mjs --init. Руками их не придумывают.
# Значение ключа нельзя показывать никому и ничему: ни в чате, ни в выводе команды.

# ── Общее ─────────────────────────────────────────────────────────────
# каталог данных отдельно от кода: /opt/ecopolis-data. Переживает выкладку
# [сервер] · обязательна
DATA_DIR=

# адрес завода с https: счётчик ссылок /go, формы /z, документы /doc
# [сервер, компьютер] · обязательна
PUBLIC_BASE_URL=

# порт сервера завода, по умолчанию 3100 (слушает только 127.0.0.1)
# [сервер] · по желанию
PORT=

# ключ оператора к очереди на сервере (/admin/queue)
# [сервер, компьютер] · обязательна · секрет
ADMIN_API_TOKEN=

# адрес сервера для команд очереди с компьютера; обычно равен PUBLIC_BASE_URL
# [компьютер] · обязательна
QUEUE_API_BASE=

# кто правит очередь: пишется в историю записи
# [компьютер] · по желанию
OPERATOR_NAME=

# каталог дубля расписания, по умолчанию mirror/ в корне проекта
# [компьютер] · по желанию
MIRROR_DIR=

# ── Telegram: бот, рабочая группа, канал ──────────────────────────────
# токен бота от BotFather. Лежит только в секретах релея
# [релей] · обязательна · секрет
TG_BOT_TOKEN=

# адрес релея: через него идут вызовы Bot API и приходят обновления
# [сервер, компьютер] · обязательна
TG_RELAY_URL=

# общий секрет сервера и релея
# [сервер, компьютер, релей] · обязательна · секрет
TG_RELAY_SECRET=

# секрет, с которым релей передаёт обновления Telegram серверу
# [сервер, релей] · обязательна · секрет
TG_WEBHOOK_SECRET=

# имя бота без @: из него строятся ссылки с метками
# [сервер, компьютер] · обязательна
TG_BOT_USERNAME=

# номер рабочей группы (-100…): согласование, заявки, отчёты, тревоги
# [сервер, компьютер] · обязательна
TG_GROUP_ID=

# номер темы «Согласование» в группе с темами
# [сервер] · по желанию
TG_TOPIC_APPROVAL=

# номер темы «Заявки»
# [сервер] · по желанию
TG_TOPIC_LEADS=

# номер темы «Отчёты»
# [сервер] · по желанию
TG_TOPIC_REPORTS=

# номер темы «Тревоги»
# [сервер, компьютер] · по желанию
TG_TOPIC_ALERTS=

# номер темы «Новости»
# [сервер] · по желанию
TG_TOPIC_NEWS=

# номер темы «Выложить руками» (Дзен)
# [сервер] · по желанию
TG_TOPIC_PACKAGES=

# номер темы «Комментарии»: сводка новых комментариев и ответы на согласование
# [сервер] · по желанию
TG_TOPIC_COMMENTS=

# числовые id Telegram тех, чьё «Одобрить» считается согласием клиента
# [сервер] · обязательна
APPROVER_IDS=

# id сотрудников, которым доступны кнопки заявок
# [сервер] · по желанию
STAFF_IDS=

# канал клиента: @имя или -100…; бот в нём администратор
# [сервер, компьютер] · нужна для площадки «Telegram-канал»
TG_CHANNEL=

# ── Threads ───────────────────────────────────────────────────────────
# маркер аккаунта Threads на 60 дней, продлевается сам
# [сервер, компьютер] · нужна для площадки «Threads» · секрет
THREADS_TOKEN=

# номер аккаунта Threads
# [сервер, компьютер] · нужна для площадки «Threads»
THREADS_USER_ID=

# имя аккаунта Threads без @: чтобы сборщик комментариев не считал собственные ответы чужими
# [сервер] · по желанию
THREADS_USERNAME=

# дата, когда маркер истечёт (ГГГГ-ММ-ДД): её ведёт продление
# [сервер, компьютер] · нужна для площадки «Threads»
THREADS_TOKEN_EXPIRES=

# ── Instagram ─────────────────────────────────────────────────────────
# маркер аккаунта Instagram на 60 дней, продлевается сам
# [сервер, компьютер] · нужна для площадки «Instagram» · секрет
IG_TOKEN=

# номер профессионального аккаунта Instagram
# [сервер, компьютер] · нужна для площадки «Instagram»
IG_USER_ID=

# имя аккаунта без @: чтобы бот не отвечал на собственные комментарии
# [сервер] · по желанию
IG_USERNAME=

# дата, когда маркер истечёт
# [сервер, компьютер] · нужна для площадки «Instagram»
IG_TOKEN_EXPIRES=

# адрес релея для вызовов к graph.instagram.com (с сервера в России напрямую не ходит). На компьютере оператора нужен на случай перехвата расписания
# [сервер, компьютер] · нужна для площадки «Instagram»
IG_RELAY_URL=

# общий секрет сервера и релея Instagram
# [сервер, компьютер, релей] · нужна для площадки «Instagram» · секрет
IG_RELAY_SECRET=

# секрет пары для пересылки событий через чужое приложение Meta. Не используется: решение владельца 10.10.2026, события идут только на своё приложение
# [сервер] · по желанию · секрет
IG_FORWARD_SECRET=

# после переезда на своё приложение Meta: его секрет для проверки подписи событий
# [сервер] · по желанию · секрет
IG_APP_SECRET=

# после переезда: слово для подтверждения вебхука своим приложением
# [сервер] · по желанию · секрет
IG_WEBHOOK_VERIFY_TOKEN=

# 1 — читать комментарии опросом раз в пять минут (если события о комментариях не приходят)
# [сервер] · по желанию
IG_POLL=

# ── Приложение Meta: вход владельца аккаунта ──────────────────────────
# номер приложения Meta для входа в Instagram. Первый месяц это приложение исполнителя, потом своё
# [компьютер] · по желанию
META_IG_APP_ID=

# секрет того же приложения: нужен только для обмена кода на маркер. На сервер клиента не кладётся
# [компьютер] · по желанию · секрет
META_IG_APP_SECRET=

# страница возврата после входа в Instagram: ровно та, что записана в настройках приложения
# [компьютер] · по желанию
META_IG_REDIRECT_URI=

# номер приложения Meta для входа в Threads
# [компьютер] · по желанию
META_THREADS_APP_ID=

# секрет приложения Threads: только для обмена кода на маркер. На сервер клиента не кладётся
# [компьютер] · по желанию · секрет
META_THREADS_APP_SECRET=

# страница возврата после входа в Threads
# [компьютер] · по желанию
META_THREADS_REDIRECT_URI=

# ── ВКонтакте ─────────────────────────────────────────────────────────
# номер сообщества без минуса
# [сервер, компьютер] · нужна для площадки «ВКонтакте, сообщество»
VK_GROUP_ID=

# ключ сообщества: текстовые записи со ссылкой на стену
# [сервер, компьютер] · нужна для площадки «ВКонтакте, сообщество» · секрет
VK_GROUP_TOKEN=

# номер приложения компании в кабинете VK ID: нужен для ключа администратора
# [сервер] · по желанию
VK_APP_ID=

# ключ администратора сообщества: загрузка фото и видео. Живёт час, обновляется сам; хранится только на сервере
# [сервер] · по желанию · секрет
VK_USER_TOKEN=

# ключ обновления VK ID: меняется при каждом обновлении, поэтому живёт в одном месте
# [сервер] · по желанию · секрет
VK_USER_REFRESH_TOKEN=

# номер устройства из входа VK ID: нужен для обновления ключа
# [сервер] · по желанию
VK_DEVICE_ID=

# когда истекает ключ администратора: ведёт обновление
# [сервер] · по желанию
VK_USER_TOKEN_EXPIRES=

# сервисный ключ приложения: просмотры своих записей и чтение чужих стен
# [сервер] · по желанию · секрет
VK_SERVICE_TOKEN=

# ── YouTube ───────────────────────────────────────────────────────────
# идентификатор клиента OAuth из проекта Google клиента
# [сервер, компьютер] · нужна для площадки «YouTube»
YOUTUBE_CLIENT_ID=

# секрет клиента OAuth
# [сервер, компьютер] · нужна для площадки «YouTube» · секрет
YOUTUBE_CLIENT_SECRET=

# ключ обновления: появляется после входа владельца канала (npm run yt -- --login)
# [сервер, компьютер] · нужна для площадки «YouTube» · секрет
YOUTUBE_REFRESH_TOKEN=

# открытый ключ API: чтение цифр и каналов конкурентов без входа
# [сервер, компьютер] · по желанию · секрет
YOUTUBE_API_KEY=

# номер канала клиента: защита от входа не тем аккаунтом Google
# [сервер, компьютер] · нужна для площадки «YouTube»
YOUTUBE_CHANNEL_ID=

# дата входа: в режиме «Тестирование» ключ живёт 7 дней
# [сервер, компьютер] · по желанию
YOUTUBE_TOKEN_ISSUED=

# ── Rutube ────────────────────────────────────────────────────────────
# ключ Rutube: без него ролики идут пакетом на ручную загрузку. Выдаётся по логину и паролю, которые вводит владелец аккаунта
# [сервер, компьютер] · по желанию · секрет
RUTUBE_TOKEN=

# номер категории ролика: 67 «Бизнес и предпринимательство» (по умолчанию), 17 «Обучение», 13 «Разное»
# [сервер] · по желанию
RUTUBE_CATEGORY=

# ── Хранилище файлов ──────────────────────────────────────────────────
# адрес объектного хранилища: https://s3.twcstorage.ru или https://storage.yandexcloud.net
# [компьютер] · нужна для площадки «Instagram»
S3_ENDPOINT=

# имя бакета с публичным чтением
# [компьютер] · нужна для площадки «Instagram»
S3_BUCKET=

# регион: ru-1 у Timeweb, ru-central1 у Яндекса
# [компьютер] · по желанию
S3_REGION=

# ключ доступа к хранилищу
# [компьютер] · нужна для площадки «Instagram» · секрет
S3_ACCESS_KEY=

# секретный ключ хранилища
# [компьютер] · нужна для площадки «Instagram» · секрет
S3_SECRET_KEY=

# публичный адрес бакета, если он отличается от адреса хранилища
# [компьютер] · по желанию
S3_PUBLIC_BASE=

# ── Резервные копии ───────────────────────────────────────────────────
# хранилище для зашифрованных копий данных: адрес. Бакет приватный и отдельный от бакета с роликами
# [сервер] · по желанию
BACKUP_S3_ENDPOINT=

# имя приватного бакета копий
# [сервер] · по желанию
BACKUP_S3_BUCKET=

# регион бакета копий, по умолчанию ru-1
# [сервер] · по желанию
BACKUP_S3_REGION=

# ключ доступа к бакету копий: живёт только на сервере
# [сервер] · по желанию · секрет
BACKUP_S3_ACCESS_KEY=

# секретный ключ бакета копий
# [сервер] · по желанию · секрет
BACKUP_S3_SECRET_KEY=

# ── Заявки и документы ────────────────────────────────────────────────
# 1 — тревоги остаются в журнале без отправки в рабочую группу; снять при сдаче
# [сервер, компьютер] · по желанию
ALERTS_MUTED=

# закрытый S3 медиатеки, отдельный от backup
# [сервер] · по желанию
MEDIA_S3_ENDPOINT=

# приватный бакет оригиналов и публикационных версий
# [сервер] · по желанию
MEDIA_S3_BUCKET=

# регион медиатеки из кабинета провайдера
# [сервер] · по желанию
MEDIA_S3_REGION=

# ключ только приватной медиатеки
# [сервер] · по желанию · секрет
MEDIA_S3_ACCESS_KEY=

# секрет только приватной медиатеки
# [сервер] · по желанию · секрет
MEDIA_S3_SECRET_KEY=

# квота локальных оригиналов, по умолчанию 512 МБ
# [сервер] · по желанию
MEDIA_LOCAL_MAX_BYTES=

# SSH-адрес единственного сервера медиатеки
# [компьютер] · по желанию
MEDIA_SSH_TARGET=

# адрес полного текста согласия на обработку; по умолчанию /doc/soglasie на заводе
# [сервер] · по желанию
CONSENT_URL=

# адрес политики обработки персональных данных
# [сервер] · по желанию
POLICY_URL=

# адрес согласия на рассылку
# [сервер] · по желанию
ADS_CONSENT_URL=

# срок ответа на заявку в рабочих минутах, по умолчанию 60
# [сервер] · по желанию
LEAD_SLA_MIN=

# ── Только релей ──────────────────────────────────────────────────────
# адрес сервера завода с https://: туда релей передаёт обновления Telegram
# [релей] · обязательна
ORIGIN_URL=
# порт релея на втором сервере, по умолчанию 8787 (слушает только 127.0.0.1)
# [релей] · по желанию
RELAY_PORT=
